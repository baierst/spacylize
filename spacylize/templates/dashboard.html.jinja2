<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Validation Report</title>
<script>{{ plotlyjs | safe }}</script>
<style>
  body { font-family: system-ui, sans-serif; margin: 0 auto; padding: 24px; max-width: 1200px; color: #222; background: #fafafa; }
  h2 { margin-top: 32px; }
  .muted { color: #777; }
  .grid { display: grid; gap: 12px; }
  @media (max-width: 700px) { .grid { grid-template-columns: 1fr !important; } }
  .card { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 8px; min-width: 0; }
  .bar { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  td { padding: 8px; border-top: 1px solid #eee; vertical-align: top; line-height: 1.6; }
  td.num { color: #777; width: 3em; }
  th { text-align: left; padding: 8px; color: #777; font-weight: normal; }
  .issue { display: inline-block; background: #fdecea; color: #a12; border-radius: 4px; padding: 0 6px; font-size: 12px; margin: 1px; white-space: nowrap; }
  mark { background: #e8eefc; border-radius: 4px; padding: 1px 4px; }
  mark small { color: #3557b7; font-weight: 600; font-size: 10px; }
  mark.conflict { background: #fdecea; }
  mark.conflict small { color: #a12; }
  pre { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 12px; white-space: pre-wrap; word-break: break-all; }
</style>
</head>
<body>
{% set dataset = report.dataset %}
<h1>Validation Report</h1>
<p class="muted">
  {{ name }} · {{ dataset.num_documents }} documents · {{ dataset.num_tokens }} tokens
  {% if dataset.num_entities is defined %} · {{ dataset.num_entities }} entities{% endif %}
</p>

<div class="grid" style="grid-template-columns: repeat({{ charts | length }}, minmax(0, 1fr))">
  {% for chart in charts %}<div class="card">{{ chart | safe }}</div>{% endfor %}
</div>

{% if report.quality.labels.by_label %}
<h2>Entity values</h2>
<div class="card">
  <table>
    <tr><th>Label</th><th>Mentions</th><th>Distinct</th><th>Values (most frequent first)</th></tr>
    {% for label, stats in report.quality.labels.by_label.items() %}
    <tr>
      <td>{{ label }}</td><td>{{ stats.total }}</td><td>{{ stats.unique }}</td>
      <td>
        {% for value, count in stats["values"][:5] %}{{ value }} ×{{ count }}{% if not loop.last %} · {% endif %}{% endfor %}
        {% if stats["values"] | length > 5 %}
        <details><summary>show all {{ stats.unique }}</summary>
          {% for value, count in stats["values"][5:] %}{{ value }} ×{{ count }}{% if not loop.last %} · {% endif %}{% endfor %}
        </details>
        {% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

<h2>Issues</h2>
{% set total = dataset.num_documents or 1 %}
<div class="card" style="max-width: 420px">
  <table id="issues">
    <tr><th>Issue</th><th>Documents</th><th>Share</th></tr>
    {% for issue, count in counts.most_common() %}
    <tr data-filter="{{ issue }}"><td><a href="#documents">{{ issue }}</a></td><td>{{ count }}</td><td>{{ (100 * count / total) | round | int }}%</td></tr>
    {% endfor %}
    <tr data-filter="any"><td><a href="#documents"><b>any issue</b></a></td><td><b>{{ report.issues | length }}</b></td><td><b>{{ (100 * report.issues | length / total) | round | int }}%</b></td></tr>
  </table>
</div>

<h2 id="documents">Documents</h2>
<div class="bar">
  <select id="filter">
    <option value="all">All documents ({{ rows | length }})</option>
    <option value="any">With issues ({{ report.issues | length }})</option>
    {% for issue, count in counts.most_common() %}<option value="{{ issue }}">{{ issue }} ({{ count }})</option>{% endfor %}
  </select>
  <button id="select">Select all shown</button>
  <button id="clear">Clear selection</button>
</div>
<div class="card">
  <table id="docs">
    {% for i, issues, text in rows %}
    <tr data-id="{{ i }}" data-issues="{{ issues | join(',') }}">
      <td><input type="checkbox"></td>
      <td class="num">{{ i }}</td>
      <td>{% for issue in issues %}<span class="issue">{{ issue }}</span> {% endfor %}{{ text | safe }}</td>
    </tr>
    {% endfor %}
  </table>
</div>
<div class="bar">
  <button id="prev">Previous</button> <span id="page" class="muted"></span> <button id="next">Next</button>
</div>

<h2>Remove selected documents</h2>
<pre id="cmd"></pre>
<button id="copy">Copy command</button>

<script>
  const rows = [...document.querySelectorAll("#docs tr")];
  const filter = document.getElementById("filter");
  const PAGE_SIZE = 25;
  let page = 0;

  const shown = () => rows.filter((r) => filter.value === "all" || (filter.value === "any"
    ? r.dataset.issues : r.dataset.issues.split(",").includes(filter.value)));

  function render() {
    const docs = shown();
    const pages = Math.max(1, Math.ceil(docs.length / PAGE_SIZE));
    page = Math.max(0, Math.min(page, pages - 1));
    rows.forEach((r) => (r.hidden = true));
    docs.slice(page * PAGE_SIZE, (page + 1) * PAGE_SIZE).forEach((r) => (r.hidden = false));
    document.getElementById("page").textContent = `Page ${page + 1} of ${pages}`;
  }

  function update() {
    const ids = rows.filter((r) => r.querySelector("input").checked).map((r) => r.dataset.id);
    document.getElementById("cmd").textContent = ids.length
      ? `spacylize clean --dataset ${ {{ dataset.path | tojson }} } --remove ${ids.join(",")}`
      : "Select documents to remove them.";
  }

  const tick = (docs, value) => { docs.forEach((r) => (r.querySelector("input").checked = value)); update(); };
  filter.onchange = () => { page = 0; render(); };
  document.getElementById("issues").onclick = (e) => {
    const row = e.target.closest("tr[data-filter]");
    if (row) { filter.value = row.dataset.filter; filter.onchange(); }
  };
  document.getElementById("prev").onclick = () => { page--; render(); };
  document.getElementById("next").onclick = () => { page++; render(); };
  document.getElementById("select").onclick = () => tick(shown(), true);
  document.getElementById("clear").onclick = () => tick(rows, false);
  document.getElementById("docs").onchange = update;
  document.getElementById("copy").onclick = () => navigator.clipboard.writeText(document.getElementById("cmd").textContent);
  render();
  update();
</script>
</body>
</html>
